# Postgres connection used by Prisma
DATABASE_URL="postgresql://fieldsync:fieldsync@localhost:5432/fieldsync?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# HTTP
PORT=3000

# CORS (comma-separated origins), used by REST + WS gateway
CORS_ORIGIN="http://localhost:3001"

# S3 / R2-compatible object storage for attachment uploads
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="fieldsync-attachments"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000/fieldsync-attachments"
