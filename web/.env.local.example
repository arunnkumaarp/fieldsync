# Backend REST API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Backend Socket.IO base URL (the /realtime namespace is appended by the client)
NEXT_PUBLIC_WS_BASE_URL=http://localhost:3000

# Optional: a MapLibre style JSON URL for the job map. Defaults to a free
# no-key-required demo style if unset — see src/lib/map-style.ts.
# NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
